// SQLite para el MVP. Para migrar a PostgreSQL: cambiar provider a "postgresql"
// y DATABASE_URL en .env, luego `pnpm db:migrate`.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Match {
  id         String   @id @default(cuid())
  externalId String   @unique // event id de The Odds API (o "manual-..." / "demo-...")
  homeTeam   String
  awayTeam   String
  kickoff    DateTime
  status     String   @default("scheduled") // scheduled | finished
  odds       MarketOdds[]
  bets       Bet[]
}

model MarketOdds {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  source    String   // pinnacle | betplay | wplay
  market    String   // h2h | totals
  line      Float    @default(0) // 2.5 para totals; 0 = sin línea (h2h)
  outcome   String   // home | draw | away | over | under
  odds      Float
  fetchedAt DateTime @default(now())

  @@unique([matchId, source, market, line, outcome])
}

model Bet {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id])
  source    String
  market    String
  line      Float     @default(0)
  outcome   String
  odds      Float
  stake     Int       // COP
  edge      Float
  status    String    @default("pending") // pending | won | lost | void
  profit    Int       @default(0) // COP, negativo si pierde
  placedAt  DateTime  @default(now())
  settledAt DateTime?
}

model Team {
  id     String @id @default(cuid())
  apiId  Int    @unique // team id de ESPN
  name   String @unique
  stats  QualifyingStats?
}

// Stats agregadas de la eliminatoria de cada selección. Contexto para
// decidir sobre picks — NO alimenta el detector de value (eso es Pinnacle).
model QualifyingStats {
  id               String   @id @default(cuid())
  teamId           String   @unique
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  confederation    String   // africa | asia | concacaf | europe | oceania | conmebol
  played           Int
  wins             Int
  draws            Int
  losses           Int
  goalsFor         Int
  goalsAgainst     Int
  formLast5        String   // ej: "WWDLW", más reciente primero
  xgForAvg         Float?   // promedios por partido — solo si stats:enrich corrió
  shotsOnTargetAvg Float?
  cornersAvg       Float?
  enrichedMatches  Int      @default(0) // sobre cuántos partidos se calcularon los promedios
  updatedAt        DateTime @updatedAt
}

model BankrollSnapshot {
  id      String   @id @default(cuid())
  date    DateTime @default(now())
  balance Int      // COP
  note    String?
}
